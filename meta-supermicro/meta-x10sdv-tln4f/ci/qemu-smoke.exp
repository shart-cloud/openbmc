#!/usr/bin/env expect
# QEMU smoke boot for the X10SDV-TLN4F (ASPEED AST2400) OpenBMC image.
#
# Boots headless on the closest in-tree QEMU AST2400 model (palmetto-bmc) -- our
# exact board is not a QEMU machine, so peripherals we wired in the DTS won't
# probe; that is expected and NOT what this checks. Real board wiring is
# validated on hardware.
#
# Milestone 2 adds entity-manager validation:
#   HARD checks (fail the boot): reached userspace + D-Bus, EntityManager service
#   active, and our X10SDV-TLN4F.json config installed.
#   SOFT checks (logged, never fail): whether entity-manager actually
#   *instantiated* an X10SDV board object. entity-manager probes on the FRU
#   product name "X10SDV-TLN4F", but palmetto-bmc has no FRU EEPROM, so the
#   config almost certainly won't instantiate under emulation. Real probe /
#   instantiation is a bench-board check. We also dump diagnostics for the two
#   M1 boot warnings (State.Host duplicate, bmcweb StateDirectory).
#   usage: qemu-smoke.exp <path-to-image.static.mtd>
#
# Two serial-console robustness measures, both learned the hard way:
#   * send -s + send_slow: the AST2400 console intermittently DOUBLES typed
#     characters, which silently corrupts long commands (a doubled char inside a
#     unit name makes systemctl miss it). Typing one char at a time avoids it.
#   * result tokens are split with '' (e.g. E''M_ACTIVE) so the literal token
#     ("EM_ACTIVE") appears only in the command's OUTPUT, never in the shell's
#     echo of the command line -- otherwise expect matches the echoed command
#     instead of the real result.
set timeout 700
set image [lindex $argv 0]
if {$image eq ""} { puts "usage: qemu-smoke.exp <image.static.mtd>"; exit 2 }
set send_slow {1 .05}

spawn qemu-system-arm -M palmetto-bmc -nographic \
    -drive file=$image,format=raw,if=mtd \
    -net nic -net user

# 1. kernel must reach a login prompt without panicking
expect {
    "Kernel panic" { puts "\n*** KERNEL PANIC ***"; exit 1 }
    timeout        { puts "\n*** no login prompt in time ***"; exit 1 }
    -re {login:}   {}
}

# 2. login (default OpenBMC creds; allow-root-login image)
send -s "root\r"
expect {
    "Password:"  { send -s "0penBmc\r"; exp_continue }
    -re {\$ |# } {}
    timeout      { puts "\n*** no shell prompt after login ***"; exit 1 }
}

# 3. HARD: userspace sanity -- D-Bus up
send -s "busctl --no-pager list >/dev/null 2>&1 && echo D''BUS_OK || echo D''BUS_FAIL\r"
expect {
    "DBUS_FAIL" { puts "\n*** D-Bus not up ***"; exit 1 }
    "DBUS_OK"   {}
    timeout     { puts "\n*** D-Bus check timed out ***"; exit 1 }
}
expect -re {\$ |# }

# 4. HARD (verdict deferred until after diagnostics): entity-manager active
set em_ok 0
send -s "systemctl is-active xyz.openbmc_project.EntityManager.service >/dev/null 2>&1 && echo E''M_ACTIVE || echo E''M_INACTIVE\r"
expect {
    "EM_ACTIVE"   { set em_ok 1 }
    "EM_INACTIVE" { set em_ok 0 }
    timeout       { set em_ok 0 }
}
expect -re {\$ |# }

# 5. HARD (verdict deferred): our config installed
set cfg_ok 0
send -s "test -f /usr/share/entity-manager/configurations/X10SDV-TLN4F.json && echo C''FG_PRESENT || echo C''FG_MISSING\r"
expect {
    "CFG_PRESENT" { set cfg_ok 1 }
    "CFG_MISSING" { set cfg_ok 0 }
    timeout       { set cfg_ok 0 }
}
expect -re {\$ |# }

# --- diagnostics: always run (even if a hard check above missed), never fatal ---
proc diag {cmd} { send -s "$cmd\r"; expect -re {\$ |# } }

# 6. SOFT: did entity-manager instantiate an X10SDV board object? Expected ABSENT
#    under palmetto-bmc (no FRU EEPROM to match the probe).
puts "\n--- DIAG: entity-manager board object (absence expected under QEMU, no FRU) ---"
diag "busctl tree xyz.openbmc_project.EntityManager 2>/dev/null | grep -i x10sdv || echo NO_X10SDV_OBJECT_UNDER_QEMU"
diag "echo CONFIGS:; ls /usr/share/entity-manager/configurations/"

# 7. SOFT DIAG: chase the M1 'State.Host@0: Two services for same bus name'
#    warning -- name every unit that claims a State.Host bus name, and re-grep
#    the boot journal for the warning itself.
puts "\n--- DIAG: State.Host bus-name claimants ---"
diag "grep -rHE 'BusName=.*State.Host' /usr/lib/systemd/system/ /etc/systemd/system/ 2>/dev/null || echo NO_STATE_HOST_BUSNAME_UNITS"
diag "ls /usr/share/dbus-1/system-services/ 2>/dev/null | grep -i State.Host || echo NO_STATE_HOST_DBUS_SVC"
diag "journalctl -b --no-pager 2>/dev/null | grep -iE 'two services|same bus name' | head -5"
diag "systemctl --no-pager --failed 2>/dev/null | head -20"

# 8. SOFT DIAG: skeleton control-power should be GONE after the EM inventory flip.
puts "\n--- DIAG: skeleton control-power (expected gone after EM flip) ---"
diag "busctl tree 2>/dev/null | grep -i '/org/openbmc/control/power' || echo NO_SKELETON_CONTROL_POWER"

# 9. SOFT DIAG: confirm the bmcweb StateDirectory line was stripped (no warning).
puts "\n--- DIAG: bmcweb StateDirectory (should report no line) ---"
diag "systemctl cat bmcweb.service 2>/dev/null | grep -nE 'StateDirectory' || echo NO_STATEDIRECTORY_LINE"

# --- verdict ---
if {$em_ok == 0}  { puts "\n*** entity-manager service not active ***"; exit 1 }
if {$cfg_ok == 0} { puts "\n*** X10SDV-TLN4F.json not installed ***"; exit 1 }

puts "\nSMOKE BOOT OK (userspace + D-Bus + entity-manager validated; board wiring NOT tested here)"
send "\x01x"
exit 0
